{
  "type": "module",
  "scripts": {
    "precheck": "tsc --noEmit --strict --module nodenext --target es2022 --erasableSyntaxOnly --verbatimModuleSyntax --allowImportingTsExtensions --types chai AcceptanceTests/Scenarios/*.ts",
    "test": "npm run precheck && sh -c 'mocha --grep \"${1:-.}\"' --",
    "generate-spec": "npm exec -- redocly bundle specs/controller/openapi.yml --dereferenced --output specs/controller/openapi-fully.yml",
    "generate-schema-types": "rm -rf AcceptanceTests/Api/Types && npm exec -- json2ts -i 'specs/controller/schemas/*.yaml' -o AcceptanceTests/Api/Types/"
  },
  "mocha": {
    "spec": [
      "AcceptanceTests/Scenarios/*.ts"
    ],
    "reporter": "github-actions"
  },
  "devDependencies": {
    "@redocly/cli": "^2.62.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chai": "^6.3.0",
    "json-schema-to-typescript": "^16.0.0",
    "mocha": "^12.0.3",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2"
  }
}
