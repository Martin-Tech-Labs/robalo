{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🍰 Cake",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/cake.cs"
        },
        {
            "internalConsoleOptions": "openOnSessionStart",
            "name": "👮‍♂️ Acceptance",
            "program": "${workspaceFolder}/node_modules/mocha/bin/mocha.js",
            "request": "launch",
            "type": "node",
            "console": "integratedTerminal",
            "args": [
                "--timeout",
                "30000"
            ],
        },
        {
            "name": "1️⃣ Controller",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build Controller",
            "program": "${workspaceFolder}/src/Robalo.Controller.Api/bin/Debug/net11.0/Robalo.Controller.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Robalo.Controller.Api/bin/Debug/net11.0",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://*:5010/"
            }
        }
    ]
}